# ==============================================================================
# AI Infrastructure Observability Console (Module 11) - Environment Configuration
# ==============================================================================

# Application Environment (development | production | test)
NODE_ENV=development

# Server Binding
HOST=0.0.0.0
PORT=8080

# Storage / Persistence (Use :memory: for in-memory SQLite, or path to local .db file)
DB_PATH=:memory:

# Ingestion & Decimation Limits
MAX_RAW_QUEUE_CAPACITY=10000
DECIMATION_WINDOW_MS=250

# Log Level (debug | info | warn | error)
LOG_LEVEL=info
